# Discover Cleaner settings.
# You don't need to copy this file: on the first start the app's Setup screen writes .env for you.
# To configure by hand instead, copy it to .env and fill in at least the two Spotify values below.
# Most settings can also be changed later in the app (Settings); lines starting with # are comments.
# Values are plain text: no quotes needed, and a value can never span more than one line.

# --- Spotify app (required) ---
# Create an app at https://developer.spotify.com/dashboard (the account that creates it needs Spotify
# Premium) and copy its Client ID and Client Secret (32 characters each).
# In the app's settings, add this exact Redirect URI: http://127.0.0.1:8888/callback
# (with --port N, use that port instead).
# Keep the secret private: never share or commit your .env file.
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
# Must match the Redirect URI registered in the dashboard exactly (read-only in the app's Settings).
# Leave it commented out to use http://127.0.0.1:<port>/callback for the port the app runs on.
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Backlog playlist ---
# The playlist to clear by listening, used on first run only (afterwards pick it in the app).
# Accepts a playlist ID, a share link (https://open.spotify.com/playlist/...) or a spotify:playlist: URI.
# PLAYLIST_ID=your_playlist_id_here
# Tracks that land in the backlog per week (Discover Weekly adds 30). Used for backlog projections. 0-500.
DISCOVER_WEEKLY_INFLOW=30

# --- Listening and polling ---
# Seconds a backlog track must play before it is cleared automatically (first-run default;
# change it live with the threshold control). Whole number, 3-600.
DEFAULT_THRESHOLD=30
# How often to check Spotify while music is playing, in seconds. 1.5-30.
POLL_INTERVAL=3
# How often to check Spotify while playback is paused, in seconds. 2-120.
POLL_INTERVAL_PAUSED=10

# --- Behavior ---
# Liked songs by one artist needed before that artist is added to your favorites automatically.
# Whole number, 0-100; 0 turns it off.
AUTO_ARTIST_LIKE_THRESHOLD=5
# How many Liked Songs to sample when profiling your library; 0 = the whole library.
LIKED_LIBRARY_SAMPLE_LIMIT=0

# --- Last.fm (optional, recommended) ---
# Enables listening history import and reports, artist bios, tags and similar artists/tracks.
# Get a free API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
# Your Last.fm username: scrobbles from this account are imported for reports and artist history.
LASTFM_USERNAME=your_lastfm_username
# Sync new scrobbles automatically in the background: 1 = on (default), 0 = off.
# LASTFM_AUTO_SYNC=1

# --- App runtime (leave these alone unless you know you need them) ---
# Folder for your history database, app state (.config.json), the Spotify sign-in cache and
# backups. Default: the app folder. A relative path is relative to the app folder. .env stays here.
# DISCOVER_DATA_DIR=data
# Flask debug mode: 0 = off (default). Never turn this on while other people can reach your computer:
# the debugger lets a browser run code.
APP_DEBUG=0
# Flask auto-reload when code changes: 0 = off (default). Only for development.
APP_USE_RELOADER=0
# Use Spotify endpoints that new or restricted developer apps no longer get (artist genres,
# related artists). 0 = off (default); leave it off unless your Spotify app was created before
# 2026-02-11 and still has them.
SPOTIFY_EXTENDED_ENDPOINTS=0

# --- Advanced tuning (optional; defaults shown) ---
# Minimum seconds heard before a play is recorded in the in-app history. 0-600.
# LISTEN_EVENT_MIN_SECONDS=10
# Legacy in-app analytics: events and backlog snapshots kept in .config.json, and the window in days.
# MAX_EVENT_HISTORY=3000
# MAX_BACKLOG_HISTORY=180
# ANALYTICS_WINDOW_DAYS=14
# How long (seconds) a Liked Songs profile stays fresh before it is rebuilt.
# LIKED_LIBRARY_PROFILE_TTL_S=43200
